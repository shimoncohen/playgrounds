{
  "name": "playgrounds",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "python3 tools/build.py",
    "check": "python3 tools/build.py --check",
    "test:engine": "node --test \"tests/shell/*.test.mjs\" \"tests/ds/*.test.mjs\" \"tests/net/*.test.mjs\" \"tests/python/*.test.mjs\" \"tests/script/*.test.mjs\"",
    "test:browser": "node tests/smoke.mjs && node tests/shell-golden.mjs",
    "test": "npm run test:engine && npm run test:browser",
    "prepare": "husky",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "playwright": "1.64.1"
  }
}
